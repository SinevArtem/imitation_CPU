      <Button layoutX="107.0" layoutY="45.0" mnemonicParsing="false" onAction="#down" prefWidth="60.0" text="Ниже" />
      <Label fx:id="arg1_label" layoutX="250.0" layoutY="30.0" prefWidth="80.0" text="arg1" />
      <Label fx:id="arg2_label" layoutX="400.0" layoutY="30.0" prefWidth="80.0" text="arg2" />
      <Label fx:id="arg3_label" layoutX="550.0" layoutY="30.0" prefWidth="80.0" text="arg3" />
   </children>
